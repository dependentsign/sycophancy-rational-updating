# Copy to .env and fill in whichever you need. Only the backend you use is read.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Point the openai backend at any compatible server (vLLM, SGLang, Ollama,
# Together, DeepSeek, OpenRouter, ...).
# OPENAI_BASE_URL=http://localhost:8000/v1

# Needed only for gated Hugging Face repos such as Llama.
# HF_TOKEN=
